{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Founder' || root.child('users').child(auth.uid).child('role').val() === 'Уполномоченный Состав')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Founder' || root.child('users').child(auth.uid).child('role').val() === 'Уполномоченный Состав')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Founder' || root.child('users').child(auth.uid).child('role').val() === 'Уполномоченный Состав' || (auth.uid === $uid && !data.exists() && newData.child('role').val() === 'Training' && newData.child('examApproved').val() === false && newData.child('email').val() === auth.token.email))",
        ".validate": "newData.hasChildren(['name','email','role','examApproved']) && (newData.child('role').val() === 'Training' || newData.child('role').val() === 'Бортпроводник' || newData.child('role').val() === 'Старший Бортпроводник' || newData.child('role').val() === 'Супервайзер' || newData.child('role').val() === 'Второй Пилот' || newData.child('role').val() === 'Капитан' || newData.child('role').val() === 'Наземный Экипаж' || newData.child('role').val() === 'Граунд Менеджер' || newData.child('role').val() === 'Хост' || newData.child('role').val() === 'Уполномоченный Состав' || newData.child('role').val() === 'Founder' || newData.child('role').val() === 'Owner') && (newData.child('role').val() === 'Training' || newData.child('examApproved').val() === true)",
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "email": { ".validate": "newData.isString() && (auth.uid === $uid && newData.val() === auth.token.email || root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Founder' || root.child('users').child(auth.uid).child('role').val() === 'Уполномоченный Состав')" },
        "role": { ".validate": "newData.isString()" },
        "examApproved": { ".validate": "newData.isBoolean()" }
      }
    },
    "flights": {
      ".read": "auth != null",
      "$flightId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Founder' || root.child('users').child(auth.uid).child('role').val() === 'Уполномоченный Состав')",
        "registrations": {
          "$uid": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Founder' || root.child('users').child(auth.uid).child('role').val() === 'Уполномоченный Состав' || (auth.uid === $uid && !data.exists() && newData.exists() && root.child('flights').child($flightId).child('status').val() === 'open' && root.child('users').child(auth.uid).child('role').val() !== 'Training' && root.child('users').child(auth.uid).child('examApproved').val() === true))",
            ".validate": "newData.hasChildren(['name','role']) && newData.child('name').isString() && newData.child('role').isString()"
          }
        }
      }
    },
    "examSubmissions": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Founder' || root.child('users').child(auth.uid).child('role').val() === 'Уполномоченный Состав')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Founder' || root.child('users').child(auth.uid).child('role').val() === 'Уполномоченный Состав')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Founder' || root.child('users').child(auth.uid).child('role').val() === 'Уполномоченный Состав' || auth.uid === $uid)",
        ".validate": "newData.hasChildren(['examKey','status']) && (root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Founder' || root.child('users').child(auth.uid).child('role').val() === 'Уполномоченный Состав' || (auth.uid === $uid && newData.child('status').val() === 'pending' && (!newData.child('score').exists() || newData.child('score').val() === null)))"
      }
    },
    "discipline": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Founder' || root.child('users').child(auth.uid).child('role').val() === 'Уполномоченный Состав')",
        "$recordId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Founder' || root.child('users').child(auth.uid).child('role').val() === 'Уполномоченный Состав')"
        }
      }
    }
  }
}
